#:import dp kivy.metrics.dp

<LoginScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: root.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        # Top hero area
        BoxLayout:
            orientation: "vertical"
            size_hint_y: 0.35
            padding: (dp(24), dp(40), dp(24), dp(20))
            spacing: dp(6)

            Label:
                text: "OsCorp"
                bold: True
                font_size: "32sp"
                color: root.header_color
                halign: "center"
                valign: "bottom"
                text_size: self.size

            Label:
                text: "Budget Manager"
                font_size: "15sp"
                color: root.header_color
                halign: "center"
                valign: "top"
                text_size: self.size

        # Card area
        BoxLayout:
            orientation: "vertical"
            size_hint_y: 0.65
            padding: (dp(20), dp(0), dp(20), dp(30))
            spacing: dp(0)

            BoxLayout:
                orientation: "vertical"
                padding: (dp(24), dp(28), dp(24), dp(28))
                spacing: dp(14)
                canvas.before:
                    Color:
                        rgba: root.card_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16), dp(16), dp(16), dp(16)]

                Label:
                    text: root.title_text
                    bold: True
                    font_size: "22sp"
                    color: root.text_color
                    size_hint_y: None
                    height: dp(32)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: root.subtitle_text
                    font_size: "13sp"
                    color: root.muted_color
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Widget:
                    size_hint_y: None
                    height: dp(4)

                TextInput:
                    id: username
                    hint_text: "Username"
                    multiline: False
                    font_size: "15sp"
                    size_hint_y: None
                    height: dp(48)
                    padding: [dp(14), dp(13), dp(14), dp(12)]
                    background_normal: ""
                    background_active: ""
                    background_color: root.field_bg
                    foreground_color: root.field_text
                    hint_text_color: root.field_hint
                    cursor_color: root.field_text
                    write_tab: False
                    on_text_validate: password.focus = True

                TextInput:
                    id: password
                    hint_text: "Password"
                    password: True
                    multiline: False
                    font_size: "15sp"
                    size_hint_y: None
                    height: dp(48)
                    padding: [dp(14), dp(13), dp(14), dp(12)]
                    background_normal: ""
                    background_active: ""
                    background_color: root.field_bg
                    foreground_color: root.field_text
                    hint_text_color: root.field_hint
                    cursor_color: root.field_text
                    write_tab: False
                    on_text_validate: root.submit()

                Label:
                    text: root.status_text
                    font_size: "12sp"
                    bold: True
                    color: root.success_color if root.status_text == "Account created." else root.danger_color
                    size_hint_y: None
                    height: dp(22)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Button:
                    text: root.action_text
                    bold: True
                    font_size: "16sp"
                    size_hint_y: None
                    height: dp(50)
                    background_normal: ""
                    background_down: ""
                    background_color: root.button_color
                    color: (1, 1, 1, 1)
                    on_press: root.submit()
