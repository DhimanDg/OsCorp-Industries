#:import dp kivy.metrics.dp

<BillsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(15)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: root.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)

            Button:
                size_hint_x: None
                width: dp(46)
                background_normal: "Assets/back_arrow.png"
                background_down: "Assets/back_arrow.png"
                background_color: root.icon_tint
                on_press: root.go_back()

            Label:
                text: "Bills & Reminders"
                bold: True
                font_size: "20sp"
                color: root.header_color
                halign: "center"
                valign: "middle"
                text_size: self.size

            Button:
                size_hint_x: None
                width: dp(86)
                text: "+ Add Bill"
                font_size: "13sp"
                bold: True
                background_normal: ""
                background_down: ""
                background_color: root.success_color
                color: (1, 1, 1, 1)
                on_press: root.open_add_popup()

        BoxLayout:
            size_hint_y: None
            height: dp(34)
            spacing: dp(8)
            padding: (dp(4), dp(2))

            BoxLayout:
                size_hint_x: 1
                padding: dp(6)
                canvas.before:
                    Color:
                        rgba: root.card_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]
                Label:
                    text: "Overdue"
                    font_size: "11sp"
                    bold: True
                    color: root.danger_color
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            BoxLayout:
                size_hint_x: 1
                padding: dp(6)
                canvas.before:
                    Color:
                        rgba: root.card_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]
                Label:
                    text: "Due <= 7 days"
                    font_size: "11sp"
                    bold: True
                    color: root.warning_color
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            BoxLayout:
                size_hint_x: 1
                padding: dp(6)
                canvas.before:
                    Color:
                        rgba: root.card_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]
                Label:
                    text: "Coming up"
                    font_size: "11sp"
                    bold: True
                    color: root.success_color
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

        ScrollView:
            GridLayout:
                id: bill_list
                cols: 1
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height
                padding: dp(4)
