#:import dp kivy.metrics.dp

<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: root.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        # ── Header ───────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: (dp(8), dp(8), dp(8), dp(4))
            spacing: dp(8)

            Button:
                size_hint: (None, None)
                size: (dp(40), dp(40))
                pos_hint: {"center_y": 0.5}
                background_normal: "Assets/back_arrow.png"
                background_down:   "Assets/back_arrow.png"
                background_color: root.icon_tint
                on_press: root.go_back()

            Label:
                text: "Settings"
                bold: True
                font_size: "22sp"
                color: root.header_color
                halign: "center"
                valign: "middle"
                text_size: self.size

            Widget:
                size_hint_x: None
                width: dp(40)

        # ── Scrollable settings sections ─────────────────────────────────
        ScrollView:
            GridLayout:
                cols: 1
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height
                padding: (dp(12), dp(8), dp(12), dp(30))

                # ── Appearance section ────────────────────────────────────
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(108)
                    padding: (dp(16), dp(14))
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: root.card_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: "Appearance"
                        bold: True
                        font_size: "15sp"
                        color: root.text_color
                        halign: "left"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Button:
                        id: theme_btn
                        text: "Switch to Dark Mode"
                        size_hint_y: None
                        height: dp(46)
                        font_size: "15sp"
                        background_normal: ""
                        background_down: ""
                        background_color: root.button_color
                        color: (1, 1, 1, 1)
                        on_press: root.toggle_theme()

                # ── Data Management section ───────────────────────────────
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(162)
                    padding: (dp(16), dp(14))
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: root.card_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: "Data Management"
                        bold: True
                        font_size: "15sp"
                        color: root.text_color
                        halign: "left"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Button:
                        text: "Reset All Budget Data & Transactions"
                        size_hint_y: None
                        height: dp(46)
                        font_size: "14sp"
                        background_normal: ""
                        background_down: ""
                        background_color: root.danger_color
                        color: (1, 1, 1, 1)
                        on_press: root.confirm_reset_data()

                    Button:
                        text: "Reset Settings to Default"
                        size_hint_y: None
                        height: dp(46)
                        font_size: "14sp"
                        background_normal: ""
                        background_down: ""
                        background_color: root.button_color
                        color: (1, 1, 1, 1)
                        on_press: root.confirm_reset_settings()

                # ── Account section ───────────────────────────────────────
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(108)
                    padding: (dp(16), dp(14))
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: root.card_color
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(12)]

                    Label:
                        text: "Account"
                        bold: True
                        font_size: "15sp"
                        color: root.text_color
                        halign: "left"
                        text_size: self.size
                        size_hint_y: None
                        height: dp(24)

                    Button:
                        text: "Sign Out"
                        size_hint_y: None
                        height: dp(46)
                        font_size: "15sp"
                        background_normal: ""
                        background_down: ""
                        background_color: root.button_color
                        color: (1, 1, 1, 1)
                        on_press: root.logout()
