#:import dp kivy.metrics.dp

<SpentScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: root.bg_color
            Rectangle:
                pos: self.pos
                size: self.size

        # ── Header ───────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: (dp(8), dp(8), dp(16), dp(4))
            spacing: dp(8)

            Button:
                size_hint: (None, None)
                size: (dp(40), dp(40))
                pos_hint: {"center_y": 0.5}
                background_normal: "Assets/back_arrow.png"
                background_down: "Assets/back_arrow.png"
                background_color: root.icon_tint
                on_press: root.go_back()

            Label:
                text: "Transaction History"
                bold: True
                font_size: "20sp"
                color: root.header_color
                halign: "center"
                valign: "middle"
                text_size: self.size

            Widget:
                size_hint_x: None
                width: dp(40)

        # ── Search bar ───────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            padding: (dp(12), dp(2), dp(12), dp(2))
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: (0, 0, 0, 0)
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                spacing: dp(8)
                padding: (dp(10), dp(4))
                canvas.before:
                    Color:
                        rgba: root.card_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]

                Label:
                    text: "Search"
                    size_hint_x: None
                    width: dp(56)
                    font_size: "13sp"
                    color: root.muted_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                TextInput:
                    id: search_input
                    hint_text: "Category, description, date, amount..."
                    multiline: False
                    background_normal: ""
                    background_active: ""
                    background_color: (0, 0, 0, 0)
                    foreground_color: root.field_text
                    hint_text_color: root.field_hint
                    cursor_color: root.field_text
                    font_size: "14sp"
                    on_text: root.on_search(self.text)

        # ── Action buttons ───────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            padding: (dp(12), dp(2), dp(12), dp(4))

            Button:
                text: "+ Add Transaction"
                bold: True
                font_size: "14sp"
                background_normal: ""
                background_down: ""
                background_color: root.success_color
                color: (1, 1, 1, 1)
                on_press: root.go_add_transaction()

            Button:
                text: "- Remove Transaction"
                bold: True
                font_size: "14sp"
                background_normal: ""
                background_down: ""
                background_color: root.danger_color
                color: (1, 1, 1, 1)
                on_press: root.open_remove_popup()

        # ── Scrollable transaction cards ─────────────────────────────────
        ScrollView:
            GridLayout:
                id: transaction_list
                cols: 1
                spacing: dp(10)
                size_hint_y: None
                height: self.minimum_height
                padding: (dp(12), dp(4), dp(12), dp(20))
